# Para só conferir a interface, nada disto é necessário: o modo de teste sobe o
# projeto com dados fictícios em memória. Ver MOCKS.md.
# USAR_MOCKS=false desliga o modo de teste e volta a exigir o que está abaixo.

# ---- Banco de dados (Neon) ----
# String de conexão do Neon (Vercel Marketplace injeta DATABASE_URL automaticamente).
DATABASE_URL=
# URL pública canônica, usada nos metadados das páginas.
NEXT_PUBLIC_SITE_URL=https://mvp-essencialfit.vercel.app
# ---- Segurança ----
# Sal para o hash do IP, usado no freio de força bruta do login.
# Gere com: openssl rand -hex 32
IP_HASH_SALT=troque-por-um-valor-aleatorio-longo
# Segredo para assinar o cookie de sessão do /admin. Gere com: openssl rand -hex 32
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# ---- Admin ----
# Senha forte do painel /admin (mínimo 16 caracteres).
ADMIN_PASSWORD=troque-por-uma-senha-forte-de-16-ou-mais
# Chave TOTP em base32. Gere com: pnpm totp:enroll (só gera se estiver vazia;
# --rotate para trocar). Cadastre no app autenticador. Ver docs/admin-acesso.md.
ADMIN_TOTP_SECRET=

# ---- Análise dos resultados (opcional) ----
# Sem estas variáveis, a análise de "Resultados & IA" é feita por regras fixas,
# sem serviço externo. Com elas, um modelo de linguagem escreve interpretações,
# hipóteses e ações sobre os números. Ele recebe só números agregados e os
# enunciados das perguntas — nenhuma resposta individual nem texto de cliente.
# Modelo no formato "fornecedor/modelo", da lista em https://ai-gateway.vercel.sh/v1/models
ANALISE_IA_MODELO=
# Chave do AI Gateway da Vercel. Num deploy da Vercel pode ficar vazia: o token
# OIDC do projeto (VERCEL_OIDC_TOKEN) é usado no lugar.
AI_GATEWAY_API_KEY=
