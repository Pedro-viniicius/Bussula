# ---- Banco de dados (Neon) ----
# String de conexão do Neon (Vercel Marketplace injeta DATABASE_URL automaticamente).
DATABASE_URL=
# Slug do evento para onde a raiz do site (/) redireciona.
NEXT_PUBLIC_EVENTO_PADRAO=fiat19
# URL pública canônica (usada no README, no cupom e nas mensagens).
NEXT_PUBLIC_SITE_URL=https://fiat-mvp-pi.vercel.app
# ---- Segurança ----
# Sal para o hash do IP. Gere com: openssl rand -hex 32
IP_HASH_SALT=troque-por-um-valor-aleatorio-longo
# Segredo para assinar o cookie de sessão do /admin. Gere com: openssl rand -hex 32
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# ---- Cloudflare Turnstile ----
# Crie um widget em https://dash.cloudflare.com/?to=/:account/turnstile
# Hostnames permitidos: fiat-mvp-pi.vercel.app e localhost
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---- Admin ----
# Senha forte do painel /admin (mínimo 16 caracteres).
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Segredo TOTP em base32. Gere com: pnpm totp:enroll
ADMIN_TOTP_SECRET=
